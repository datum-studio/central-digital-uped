rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function papel() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel;
    }

    function temPapel(papeis) {
      return logado() && papel() in papeis;
    }

    // Cada funcionário só lê o próprio documento de usuário (nome/papel).
    // A criação/edição de usuários é feita manualmente pelo admin no Console.
    match /usuarios/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if false;
    }

    // Cardápio da semana — leitura pública (a Home não exige login), escrita só Nutrição/admin.
    match /cardapio/{semanaId} {
      allow read: if true;
      allow write: if temPapel(["admin", "nutricao"]);
    }

    // Documento em destaque — leitura pública, escrita Direção/NEP/admin.
    match /destaque/{docId} {
      allow read: if true;
      allow write: if temPapel(["admin", "direcao", "educacao_permanente"]);
    }

    // Comunicados — leitura pública, escrita Direção/admin.
    match /comunicados/{id} {
      allow read: if true;
      allow write: if temPapel(["admin", "direcao"]);
    }

    // Aniversariantes — leitura pública, escrita RH/admin.
    match /aniversariantes/{id} {
      allow read: if true;
      allow write: if temPapel(["admin", "rh"]);
    }

    // Protocolos e POPs — leitura pública, escrita NEP/admin.
    match /pops/{id} {
      allow read: if true;
      allow write: if temPapel(["admin", "educacao_permanente"]);
    }

    // Educação Permanente (treinamentos, materiais, certificados, links) — leitura pública, escrita NEP/admin.
    match /educacao/{id} {
      allow read: if true;
      allow write: if temPapel(["admin", "educacao_permanente"]);
    }

    // Mural de alertas de segurança — leitura pública, escrita Qualidade/admin.
    match /alertas/{id} {
      allow read: if true;
      allow write: if temPapel(["admin", "qualidade"]);
    }

    // Indicadores de qualidade — leitura pública, escrita Qualidade/admin.
    match /indicadores/{id} {
      allow read: if true;
      allow write: if temPapel(["admin", "qualidade"]);
    }

    // Notificações de evento adverso.
    // Qualquer pessoa pode ENVIAR (sem login, para permitir notificação anônima),
    // mas ninguém pode ler, alterar ou apagar sem ser Qualidade/Direção/admin.
    // A validação abaixo limita o tamanho e os campos do que entra.
    match /notificacoes/{id} {
      allow read, update, delete: if temPapel(["admin", "qualidade", "direcao"]);
      allow create: if request.resource.data.keys().hasOnly(
                         ["tipo", "dataEvento", "setor", "descricao", "dano", "contato", "status", "criadoEm"])
                    && request.resource.data.keys().hasAll(
                         ["tipo", "dataEvento", "setor", "descricao", "dano", "contato", "status", "criadoEm"])
                    && request.resource.data.tipo is string && request.resource.data.tipo.size() <= 60
                    && request.resource.data.dataEvento is string && request.resource.data.dataEvento.size() <= 10
                    && request.resource.data.setor is string && request.resource.data.setor.size() <= 120
                    && request.resource.data.descricao is string
                    && request.resource.data.descricao.size() >= 10
                    && request.resource.data.descricao.size() <= 3000
                    && request.resource.data.dano is string && request.resource.data.dano.size() <= 40
                    && request.resource.data.contato is string && request.resource.data.contato.size() <= 200
                    && request.resource.data.status == "nova"
                    && request.resource.data.criadoEm == request.time;
    }

    // Documentos Institucionais — leitura pública, escrita Direção/admin.
    match /documentos/{id} {
      allow read: if true;
      allow write: if temPapel(["admin", "direcao"]);
    }
  }
}
